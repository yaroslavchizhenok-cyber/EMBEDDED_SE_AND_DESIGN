# big.show - the same idea with 25 drones: does it scale?
#
#   uv run show.py shows/big.show
#
# Bigger formations, the same safety rules.  Note the spacing: slots and
# pads are 4.5 m apart, half as much again as sep.  Straight paths flown in
# step are only guaranteed not to cross closer than sep when both ends are
# spaced by about 1.4 x sep (planner.py's notes); at exactly sep, 25 drones
# rising off a line of pads into a tight grid need more repairs than the
# planner will try, and the show is refused.  Try it: pads 3, grid size=12.

drones   25
pads     4.5
takeoff  5
vmax     3
vzmax    1.5
amax     1
sep      3
safe     1
settle   1
wind     4 120
gps      rtk

form  grid    8     y=12 z=14  size=18 plane=wall
form  circle  8     y=12 z=20  size=36 plane=wall
form  heart   10    y=12 z=22  size=36 plane=wall
form  v       8     y=16 z=10  size=48 turn=180 name=arrow
form  cross   8     y=12 z=12  size=40
